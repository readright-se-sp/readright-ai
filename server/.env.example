# ReadRight MAI server configuration.
# Copy to `.env` in this folder (server/) and fill in the values:
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   Copy-Item .env.example .env (PowerShell)
# Real environment variables (e.g. a MAI_API_KEY left in your shell) override values in this
# file; the server logs a warning at startup when that happens.
# Never commit `.env`.

# Required. Key the BE sends in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#               or: openssl rand -base64 32
# Empty keys and the placeholder below are rejected at startup.
MAI_API_KEY=change-me

# DEBUG, INFO, WARNING or ERROR.
MAI_LOG_LEVEL=INFO

# Internal deadline per request, in seconds. The contract's hard limit is 120 s.
MAI_REQUEST_DEADLINE_SECONDS=115

# If the video lane fails or runs late: false = fail the whole request (agreed default),
# true = return the audio-only result with is_finger_pointing=false.
MAI_ALLOW_AUDIO_ONLY_ON_VIDEO_FAILURE=false

# S3 key prefix for mini audio files when the request has no output_key_prefix.
# {request_id} is replaced with the request's id.
MAI_DEFAULT_OUTPUT_KEY_PREFIX=analyses/{request_id}/miscues/

# Redis holding the idempotency records. May contain a password; never logged.
# Local Redis: docker run -d -p 6379:6379 redis:7
MAI_REDIS_URL=redis://localhost:6379/0

# Lease on an in-progress request_id, in seconds. Must be greater than the request deadline.
MAI_IN_PROGRESS_TTL_SECONDS=130

# How long a finished result can be replayed, in seconds (604800 = 7 days).
MAI_RESULT_TTL_SECONDS=604800

# Connect/read timeout per Redis call, in seconds.
MAI_REDIS_TIMEOUT_SECONDS=2

# Per-request working directory root. Empty = <system temp>/readright-mai.
# MAI_SCRATCH_DIR=

# Largest video to download, in bytes (209715200 = 200 MiB).
MAI_MAX_VIDEO_BYTES=209715200

# ffmpeg / ffprobe executables (names on PATH, or full paths).
MAI_FFMPEG_PATH=ffmpeg
MAI_FFPROBE_PATH=ffprobe

# Audio and video lane workers (see contracts/worker-api.md). For local runs start the fake
# workers: uv run uvicorn devtools.fake_workers:audio_app --port 8001 (and video_app on 8002).
MAI_AUDIO_WORKER_URL=http://localhost:8001
MAI_VIDEO_WORKER_URL=http://localhost:8002

# Connect timeout per lane call, in seconds (capped by the remaining request deadline).
MAI_WORKER_CONNECT_TIMEOUT_SECONDS=5

# Settings added in later phases (not used yet):
# MAI_S3_BUCKET=...  AWS_REGION=ap-southeast-1  (Phase 5)
