# ReadRight MAI audio lane configuration.
# Copy to `.env` in this folder (audio/) and adjust the values.
AUDIO_LOG_LEVEL=INFO
AUDIO_DATA_DIR=data
# espeak-ng voice used for passage phonemes
AUDIO_ESPEAK_LANGUAGE=en-us
# Path to libespeak-ng.dll / .so (needed on Windows), for example:
# AUDIO_ESPEAK_LIBRARY=C:\Program Files\eSpeak NG\libespeak-ng.dll
# Number of prepared passages kept in memory
AUDIO_PASSAGE_CACHE_SIZE=128
