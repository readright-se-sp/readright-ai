# ReadRight MAI audio lane configuration.
# Copy to `.env` in this folder (audio/) and adjust the values.
AUDIO_LOG_LEVEL=INFO
AUDIO_DATA_DIR=data
# espeak-ng voice used for passage phonemes
AUDIO_ESPEAK_LANGUAGE=en-us
# Path to libespeak-ng.dll / .so (needed on Windows), for example:
# AUDIO_ESPEAK_LIBRARY=C:\Program Files\eSpeak NG\libespeak-ng.dll
# Number of prepared passages kept in memory
AUDIO_PASSAGE_CACHE_SIZE=128
# Phoneme recogniser: Hugging Face id or local path (weights go to the HF cache, HF_HOME)
AUDIO_PHONEME_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft
# auto (CUDA if available), cuda or cpu
AUDIO_PHONEME_DEVICE=auto
# Half precision on CUDA; ignored on CPU
AUDIO_PHONEME_FP16=false
# Seconds of audio per forward pass, and extra context seconds on each side (discarded)
AUDIO_PHONEME_CHUNK_S=20
AUDIO_PHONEME_CONTEXT_S=2
# Lane B on/off: false runs the word lane alone and loads no phoneme model
AUDIO_PHONETIC_ENABLED=true
# Join by time: furthest a word's window reaches into a gap (ms), minimum length of an unclaimed
# phoneme run to report (ms), and the silence that ends such a run (ms)
AUDIO_JOIN_MAX_REACH_MS=150
AUDIO_COVERAGE_MIN_MS=120
AUDIO_COVERAGE_MAX_GAP_MS=300
# Arbitration thresholds on the phoneme distance. Startup fails unless T_FLAG < T_OVERRULE
AUDIO_T_FLAG=0.25
AUDIO_T_OVERRULE=0.45
