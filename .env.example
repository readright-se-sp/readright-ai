# Settings for `docker compose` (copy to `.env` in this folder). Never commit `.env`.

# Required. Key the BE sends in the X-API-Key header. On the EC2 instance scripts/start-stack.sh
# reads it from SSM Parameter Store instead.
MAI_API_KEY=change-me

# Caddy site address. localhost = local TLS with Caddy's internal CA; on EC2 use the DNS name.
MAI_SITE_ADDRESS=localhost

# S3 bucket for the mini audio files (production compose only; the local override uses moto).
MAI_S3_BUCKET=
AWS_REGION=ap-southeast-2

# DEBUG, INFO, WARNING or ERROR.
MAI_LOG_LEVEL=INFO

# CPUs the video worker may use (MediaPipe on CPU). Default 4 of the instance's 8.
MAI_VIDEO_CPUS=4

# Video worker tuning (see video/README.md). Leave unset to use the defaults baked into the image
# (video/app/config.py); set one to override it after calibration or the load test, then
# re-run scripts/start-stack.sh (or `docker compose up -d`).
# MAI_VIDEO_LOG_LEVEL=INFO
# MAI_VIDEO_MAX_CONCURRENT_JOBS=2
# MAI_VIDEO_SAMPLE_FPS=5.0
# MAI_VIDEO_USE_POSE=false
# MAI_VIDEO_EXPRESSION_MIN_RANGE=0.12
# MAI_VIDEO_EXPRESSION_GROUP_MIN_RANGE={"brow_down": 0.20}
# MAI_VIDEO_POINTING_MIN_TOTAL_MS=2000
# MAI_VIDEO_POINTING_EXTENDED_MAX_BEND_DEG=35
# MAI_VIDEO_SWEEP_MIN_COUNT=2

# Audio worker (see audio/README.md). Lane B (phoneme arbitration) is off until B6b shows it helps;
# turning it on needs no rebuild, the phoneme model is already in the image.
# AUDIO_PHONETIC_ENABLED=false
# AUDIO_WORKER_MAX_CONCURRENT_JOBS=1
# AUDIO_WORKER_LOG_LEVEL=INFO
