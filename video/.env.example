# Copy to .env and adjust. Env vars override this file.
MAI_VIDEO_LOG_LEVEL=INFO
# Unset = any absolute path is accepted. Compose sets /scratch.
# MAI_VIDEO_ALLOWED_MEDIA_DIR=/scratch
MAI_VIDEO_MAX_CONCURRENT_JOBS=2
MAI_VIDEO_STATS_WINDOW=20
MAI_VIDEO_DISCONNECT_POLL_SECONDS=0.5
# ffmpeg and ffprobe binaries (name on PATH or absolute path).
MAI_VIDEO_FFMPEG_PATH=ffmpeg
MAI_VIDEO_FFPROBE_PATH=ffprobe
# Time limit for each ffprobe call.
MAI_VIDEO_PROBE_TIMEOUT_SECONDS=10
# Frames sampled per second (lowered for long videos so MAX_FRAMES holds).
MAI_VIDEO_SAMPLE_FPS=5.0
# Decoded frame width in pixels (never above the source width).
MAI_VIDEO_FRAME_WIDTH=640
# Upper bound on frames decoded per job.
MAI_VIDEO_MAX_FRAMES=900
# Directory holding the MediaPipe model files (fetch with devtools.fetch_models).
MAI_VIDEO_MODEL_DIR=models
# Most hands detected per frame (1-4).
MAI_VIDEO_NUM_HANDS=2
# Also run the pose landmarker (loads pose_landmarker_lite.task).
MAI_VIDEO_USE_POSE=false
# Share of frames that must show a face for the expression check (0-1).
MAI_VIDEO_EXPRESSION_MIN_FACE_COVERAGE=0.5
# Fewest frames with a face for the expression check.
MAI_VIDEO_EXPRESSION_MIN_FACE_FRAMES=20
# Median smoothing window in frames (odd, at most EXPRESSION_MIN_FACE_FRAMES).
MAI_VIDEO_EXPRESSION_SMOOTH_FRAMES=3
# Minimum range a facial movement group needs to count as expression (0-1).
MAI_VIDEO_EXPRESSION_MIN_RANGE=0.12
# JSON overrides of the minimum for single groups, e.g. {"smile": 0.2}.
MAI_VIDEO_EXPRESSION_GROUP_MIN_RANGE={"brow_down": 0.20}
# Pointing: lowest hand confidence that can count as a pointing hand (0-1).
MAI_VIDEO_POINTING_MIN_HAND_SCORE=0.5
# Pointing: a finger is straight when its joints bend less than this (degrees).
MAI_VIDEO_POINTING_EXTENDED_MAX_BEND_DEG=35
# Pointing: a finger is curled when its middle joint bends at least this (degrees).
MAI_VIDEO_POINTING_CURLED_MIN_BEND_DEG=60
# Pointing moments closer than this are joined into one episode (ms).
MAI_VIDEO_POINTING_MERGE_GAP_MS=400
# Shortest pointing episode that counts (ms).
MAI_VIDEO_POINTING_MIN_EPISODE_MS=600
# Least total pointing time for the flag (ms).
MAI_VIDEO_POINTING_MIN_TOTAL_MS=2000
# Least share of the recording spent pointing (0-1); the larger of the two totals applies.
MAI_VIDEO_POINTING_MIN_TOTAL_FRACTION=0.05
# Also count fingertip sweeps that look like tracking lines of text.
MAI_VIDEO_POINTING_USE_SWEEPS=true
# Shortest one-way fingertip movement that counts as a sweep (ms).
MAI_VIDEO_SWEEP_MIN_MS=1000
# Least sideways distance of a sweep (share of frame width, 0-1).
MAI_VIDEO_SWEEP_MIN_DX=0.10
# Time after a sweep in which the fingertip must move back at least half way (ms).
MAI_VIDEO_SWEEP_RETURN_MAX_MS=1000
# Sweeps needed for the flag.
MAI_VIDEO_SWEEP_MIN_COUNT=2
# Pose cue (needs USE_POSE): least wrist visibility (0-1).
MAI_VIDEO_POINTING_POSE_MIN_VISIBILITY=0.5
# Pose cue (needs USE_POSE): wrist must be in this bottom share of the frame height (0-1).
MAI_VIDEO_POINTING_POSE_BOTTOM_BAND=0.3
