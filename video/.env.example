# Copy to .env and adjust. Env vars override this file.
MAI_VIDEO_LOG_LEVEL=INFO
# Unset = any absolute path is accepted. Compose sets /scratch.
# MAI_VIDEO_ALLOWED_MEDIA_DIR=/scratch
MAI_VIDEO_MAX_CONCURRENT_JOBS=2
MAI_VIDEO_STATS_WINDOW=20
MAI_VIDEO_DISCONNECT_POLL_SECONDS=0.5
# ffmpeg and ffprobe binaries (name on PATH or absolute path).
MAI_VIDEO_FFMPEG_PATH=ffmpeg
MAI_VIDEO_FFPROBE_PATH=ffprobe
# Time limit for each ffprobe call.
MAI_VIDEO_PROBE_TIMEOUT_SECONDS=10
# Frames sampled per second (lowered for long videos so MAX_FRAMES holds).
MAI_VIDEO_SAMPLE_FPS=5.0
# Decoded frame width in pixels (never above the source width).
MAI_VIDEO_FRAME_WIDTH=640
# Upper bound on frames decoded per job.
MAI_VIDEO_MAX_FRAMES=900
